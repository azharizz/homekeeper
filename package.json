{
  "name": "homekeeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --env-file-if-exists=.env alexa_host/server.js",
    "start:all": "node --env-file-if-exists=.env scripts/start.js",
    "roomtrace": "node --env-file-if-exists=.env scripts/start.js roomtrace",
    "capability": "node --env-file-if-exists=.env capability/server.js",
    "test": "node --test tests/*.test.js",
    "check:live": "node --env-file=.env scripts/live-check.js",
    "setup": "node scripts/setup.js",
    "check:browser": "node scripts/browser-check.js",
    "check:roomtrace": "node --env-file-if-exists=.env scripts/roomtrace-check.js",
    "format": "prettier --write capability alexa_host web scripts tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.90.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "playwright": "1.63.0",
    "prettier": "3.9.8",
    "vite": "8.3.0"
  }
}
